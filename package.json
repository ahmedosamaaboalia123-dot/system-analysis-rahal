{
  "name": "@madar/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.19.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && node tools/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "node tools/check-scripts.mjs --test-inputs && vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build && node tools/check-build.mjs",
    "check:workspace": "node tools/check-workspace.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:ownership": "node tools/check-ownership.mjs",
    "check:scripts": "node tools/check-scripts.mjs",
    "check:contracts": "node tools/check-contract-files.mjs",
    "check:security": "node tools/check-security.mjs",
    "test:negative": "node tools/test-quality-gates.mjs",
    "verify:s02": "node tools/run-quality-gates.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@madar/s02-fixture": "workspace:*",
    "@playwright/test": "1.65.1",
    "@redocly/cli": "1.34.5",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.0"
  }
}
